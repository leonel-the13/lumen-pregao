# Lúmen Lab — variáveis de ambiente (sem valores reais; copia para .env)

# Base de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/lumen
DB_USER=lumen
DB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# Email: em produção, RESEND_API_KEY (API HTTP do Resend); sem chave usa SMTP (Mailpit em desenvolvimento)
RESEND_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responder@exemplo.ao

# Segurança
# MFA_ENC_KEY: chave AES-256 para cifrar segredos TOTP (32 bytes, base64)
MFA_ENC_KEY=
# PROXY_SECRET: segredo partilhado frontend↔backend para aceitar o IP real do cliente (X-Client-IP). Igual nos dois.
PROXY_SECRET=
# Cookie de sessão com Secure (true em produção)
SESSION_COOKIE_SECURE=true

# Domínio de email institucional permitido no registo — a confirmar
ALLOWED_EMAIL_DOMAIN=isptec.co.ao
# Parte local do email de estudante (regex). Por defeito: número de estudante com 8 dígitos. Vazio = sem regra.
ALLOWED_EMAIL_LOCAL_PATTERN=^[0-9]{8}$

# URL público da aplicação (links em emails)
APP_BASE_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE=/api/v1
# URL interno do backend usado pelo servidor Next.js (Server Components e rewrites)
BACKEND_INTERNAL_URL=http://localhost:8080

# Postgres (contentor de desenvolvimento)
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=
